<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- NotifyIcon (tray) and Screen only; UI stays WPF -->
    <RootNamespace>PictureViewer</RootNamespace>
    <AssemblyName>PictureViewer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.1</Version>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages> <!-- the UI is English; skip the framework's translations -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn> <!-- DPI is set in the manifest for WPF; WinForms is only used for the tray icon -->

  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WPF / WinForms type clashes (Application, Clipboard, ...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- The WPF SDK drops these from implicit usings -->
    <Using Include="System.IO" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <!-- When this build was made, shown in About (local time of the machine that built it) -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="15.0.0" />
  </ItemGroup>

</Project>
