<Window x:Class="PictureViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PictureViewer"
        Title="Picture Viewer" Icon="Resources/app.ico" Height="760" Width="1180" MinWidth="1120" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKeyDown" Closing="OnClosing" Closed="OnClosed">
    <DockPanel>

        <!-- Toolbar -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1"
                Padding="6,4">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="&#xE8E5;" ToolTip="Open (Ctrl+O)" Click="OnOpenClick"/>
                    <Button x:Name="PrevButton" Style="{StaticResource ToolButton}" Content="&#xE76B;" ToolTip="Previous (←)" Click="OnPrevClick"/>
                    <Button x:Name="NextButton" Style="{StaticResource ToolButton}" Content="&#xE76C;" ToolTip="Next (→)" Click="OnNextClick"/>
                    <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                    <Button x:Name="SlideshowButton" Style="{StaticResource ToolButton}" Content="&#xE768;" ToolTip="Start slideshow (Space)" Click="OnSlideshowClick"/>
                    <ToggleButton x:Name="InfoButton" Style="{StaticResource ToolToggle}" Content="&#xE946;" ToolTip="Info panel (Ctrl+I)" Checked="OnInfoToggled" Unchecked="OnInfoToggled"/>
                    <ToggleButton x:Name="ThumbsButton" Style="{StaticResource ToolToggle}" Content="&#xE80A;" ToolTip="Thumbnail strip (Ctrl+T)" Checked="OnThumbsToggled" Unchecked="OnThumbsToggled"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RotateLeftButton" Style="{StaticResource ToolButton}" Content="&#x21BA;" FontFamily="Segoe UI Symbol" FontSize="20" ToolTip="Rotate left (Ctrl+[)" Click="OnRotateLeftClick"/>
                    <Button x:Name="RotateRightButton" Style="{StaticResource ToolButton}" Content="&#x21BB;" FontFamily="Segoe UI Symbol" FontSize="20" ToolTip="Rotate right (Ctrl+])" Click="OnRotateRightClick"/>
                    <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                    <Button x:Name="CopyButton" Style="{StaticResource ToolButton}" Content="&#xE8C8;" ToolTip="Copy picture (Ctrl+C)" Click="OnCopyClick"/>
                    <Button x:Name="PrintButton" Style="{StaticResource ToolButton}" Content="&#xE749;" ToolTip="Print (Ctrl+P)" Click="OnPrintClick"/>
                    <Button x:Name="PasteButton" Style="{StaticResource ToolButton}" Content="&#xE77F;" ToolTip="Paste picture (Ctrl+V)" Click="OnPasteClick"/>
                    <Button x:Name="RenameButton" Style="{StaticResource ToolButton}" Content="&#xE70F;" ToolTip="Rename (F2)" Click="OnRenameClick"/>
                    <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Content="&#xE74D;" ToolTip="Move to Recycle Bin (Delete)" Click="OnDeleteClick"/>
                    <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                    <Button x:Name="ZoomOutButton" Style="{StaticResource ToolButton}" Content="&#xE71F;" ToolTip="Zoom out (-)" Click="OnZoomOutClick"/>
                    <Button x:Name="ZoomInButton" Style="{StaticResource ToolButton}" Content="&#xE8A3;" ToolTip="Zoom in (+)" Click="OnZoomInClick"/>
                    <Button x:Name="FitButton" Style="{StaticResource ToolButton}" Content="Fit" FontFamily="Segoe UI" FontSize="13" Width="44" ToolTip="Fit to window (0)" Click="OnFitClick"/>
                    <Button x:Name="ActualButton" Style="{StaticResource ToolButton}" Content="100%" FontFamily="Segoe UI" FontSize="13" Width="48" ToolTip="Actual size (1)" Click="OnActualClick"/>
                    <Button Style="{StaticResource ToolButton}" Content="&#xE740;" ToolTip="Full screen (F11)" Click="OnFullScreenClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Annotation bar -->
        <Border x:Name="AnnotBar" DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1"
                Padding="6,3">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ToggleButton x:Name="ToolNone" Tag="None" Style="{StaticResource ToolToggle}" ToolTip="Select and move annotations (Esc)" Click="OnToolClick">
                        <Canvas Width="18" Height="18"><Path Style="{StaticResource IconFill}" Data="M4,2 L4,14 L7,11 L9.5,16 L11.5,15 L9,10 L13,10 Z"/></Canvas>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolLine" Tag="Line" Style="{StaticResource ToolToggle}" ToolTip="Line (click again to turn off)" Click="OnToolClick">
                        <Canvas Width="18" Height="18"><Path Style="{StaticResource IconStroke}" Data="M3,15 L15,3"/></Canvas>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolArrow" Tag="Arrow" Style="{StaticResource ToolToggle}" ToolTip="Arrow" Click="OnToolClick">
                        <Canvas Width="18" Height="18"><Path Style="{StaticResource IconStroke}" Data="M3,15 L15,3 M8,3 L15,3 L15,10"/></Canvas>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolRect" Tag="Rect" Style="{StaticResource ToolToggle}" ToolTip="Rectangle" Click="OnToolClick">
                        <Canvas Width="18" Height="18"><Path Style="{StaticResource IconStroke}" Data="M3,4 H15 V14 H3 Z"/></Canvas>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolEllipse" Tag="Ellipse" Style="{StaticResource ToolToggle}" ToolTip="Circle / ellipse" Click="OnToolClick">
                        <Canvas Width="18" Height="18"><Path Style="{StaticResource IconStroke}" Data="M3,9 A6,5 0 1 0 15,9 A6,5 0 1 0 3,9 Z"/></Canvas>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolPen" Tag="Pen" Style="{StaticResource ToolToggle}" ToolTip="Freehand pen" Click="OnToolClick">
                        <Canvas Width="18" Height="18"><Path Style="{StaticResource IconStroke}" Data="M3,14 C5,6 7,16 9,9 S13,5 15,8"/></Canvas>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolText" Tag="Text" Style="{StaticResource ToolToggle}" ToolTip="Text" Click="OnToolClick">
                        <TextBlock Text="T" FontFamily="Georgia" FontWeight="Bold" FontSize="17"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolMosaic" Tag="Mosaic" Style="{StaticResource ToolToggle}" ToolTip="Mosaic: pixelate an area (width sets the block size)" Click="OnToolClick">
                        <Canvas Width="18" Height="18"><Path Style="{StaticResource IconFill}" Data="M2,2 H7 V7 H2 Z M12,2 H16 V7 H12 Z M7,7 H12 V12 H7 Z M2,12 H7 V16 H2 Z M12,12 H16 V16 H12 Z"/></Canvas>
                    </ToggleButton>
                    <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                    <local:ColorButton x:Name="ColorPick" ToolTip="Annotation color"/>
                    <ComboBox x:Name="WidthBox" Width="96" Height="26" Margin="4,0" VerticalContentAlignment="Center" Focusable="False"
                              SelectedIndex="1" ToolTip="Line width / text size / mosaic block size" SelectionChanged="OnStyleChanged">
                        <ComboBoxItem Content="Thin"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="Thick"/>
                        <ComboBoxItem Content="Heavy"/>
                    </ComboBox>
                    <StackPanel x:Name="TextOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                        <ComboBox x:Name="FontBox" Width="150" Height="26" Margin="4,0" VerticalContentAlignment="Center" Focusable="False"
                                  ToolTip="Font" SelectionChanged="OnStyleChanged"/>
                        <ToggleButton x:Name="BoldButton" Style="{StaticResource ToolToggle}" Width="30" IsChecked="True" ToolTip="Bold" Checked="OnStyleChanged" Unchecked="OnStyleChanged">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="15"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicButton" Style="{StaticResource ToolToggle}" Width="30" ToolTip="Italic" Checked="OnStyleChanged" Unchecked="OnStyleChanged">
                            <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" FontSize="15"/>
                        </ToggleButton>
                        <TextBlock Text="Background" VerticalAlignment="Center" Margin="10,0,2,0"/>
                        <local:ColorButton x:Name="BackgroundPick" AllowNone="True" ToolTip="Text background color"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="CropButton" Style="{StaticResource ToolToggle}" Content="&#xE7A8;" ToolTip="Crop: drag the area to keep, then click again to apply (Ctrl+K)" Click="OnCropClick"/>
                    <Button x:Name="FlipHButton" Style="{StaticResource ToolButton}" Content="&#x21CB;" FontFamily="Segoe UI Symbol" FontSize="20" ToolTip="Flip horizontally" Click="OnFlipHClick"/>
                    <Button x:Name="FlipVButton" Style="{StaticResource ToolButton}" Content="&#x21C5;" FontFamily="Segoe UI Symbol" FontSize="20" ToolTip="Flip vertically" Click="OnFlipVClick"/>
                    <Button x:Name="AdjustButton" Style="{StaticResource ToolButton}" Content="&#xE706;" ToolTip="Brightness / contrast / saturation" Click="OnAdjustClick"/>
                    <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                    <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Click="OnUndoClick"/>
                    <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Content="&#xE74E;" ToolTip="Save (Ctrl+S)" Click="OnSaveClick"/>
                    <Button x:Name="SaveCopyButton" Style="{StaticResource ToolButton}" Content="&#xE792;" ToolTip="Save a copy… (Ctrl+Shift+S)" Click="OnSaveCopyClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Margin="16,0,0,0"/>
                <TextBlock x:Name="InfoText" DockPanel.Dock="Right" Margin="16,0,0,0"/>
                <TextBlock x:Name="PositionText" DockPanel.Dock="Right"/>
                <TextBlock x:Name="NameText" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Thumbnail strip -->
        <ListBox x:Name="Strip" DockPanel.Dock="Bottom" Height="72" Visibility="Collapsed"
                 Background="#2B2B2B" BorderThickness="0" Focusable="False"
                 ItemContainerStyle="{StaticResource ThumbItemStyle}"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 SelectionChanged="OnStripSelectionChanged" PreviewMouseWheel="OnStripWheel">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ThumbItem}">
                    <Image Source="{Binding Thumb}" Stretch="Uniform" ToolTip="{Binding FileName}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Viewer -->
        <Grid Background="#1E1E1E">
            <local:ZoomPanView x:Name="View">
                <local:ZoomPanView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open…" InputGestureText="Ctrl+O" Click="OnOpenClick"/>
                        <Separator/>
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="OnCopyClick"/>
                        <MenuItem Header="Print…" InputGestureText="Ctrl+P" Click="OnPrintClick"/>
                        <MenuItem Header="Rename…" InputGestureText="F2" Click="OnRenameClick"/>
                        <MenuItem Header="Move to Recycle Bin" InputGestureText="Del" Click="OnDeleteClick"/>
                        <MenuItem Header="Show in Explorer" InputGestureText="Ctrl+R" Click="OnRevealClick"/>
                        <Separator/>
                        <MenuItem Header="Info panel" InputGestureText="Ctrl+I" Click="OnInfoMenuClick"/>
                        <MenuItem Header="Thumbnail strip" InputGestureText="Ctrl+T" Click="OnThumbsMenuClick"/>
                        <MenuItem Header="Slideshow" InputGestureText="Space" Click="OnSlideshowClick"/>
                        <MenuItem Header="Full screen" InputGestureText="F11" Click="OnFullScreenClick"/>
                        <Separator/>
                        <MenuItem Header="About Picture Viewer" Click="OnAboutClick"/>
                    </ContextMenu>
                </local:ZoomPanView.ContextMenu>
            </local:ZoomPanView>

            <TextBlock x:Name="EmptyText" Foreground="#A0A0A0" FontSize="18" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       TextWrapping="Wrap" MaxWidth="560"
                       Text="Drop a picture or folder here, or press Ctrl+O"/>

            <Border x:Name="InfoPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="12" Padding="12,10" CornerRadius="6" Background="#CC202020" IsHitTestVisible="False" MaxWidth="420">
                <TextBlock x:Name="InfoPanelText" Foreground="White" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
            </Border>

            <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,28" Padding="16,9" CornerRadius="8" Background="#E0202020" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="14"/>
            </Border>

            <Button x:Name="PrevOverlay" Style="{StaticResource OverlayArrow}" Content="&#xE76B;"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Click="OnPrevClick"/>
            <Button x:Name="NextOverlay" Style="{StaticResource OverlayArrow}" Content="&#xE76C;"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Click="OnNextClick"/>
        </Grid>

    </DockPanel>
</Window>
